// Free Pointer : Tells where the new data will be stored
// Start Pointer : Tells where the linked list is starting from

TYPE linkedList 
    DECLARE Node : STRING
    DECLARE NextPointer : INTEGER
ENDTYPE

DECLARE StartPointer , FreePointer : INTEGER
DECLARE List : ARRAY [1:5] OF linkedList

CONSTANT NullPointer = 0

// INITIALIZING OF LINKED LIST 

PROCEDURE Initialise()
 StartPointer <- 0
 FreePointer <- 1
 FOR x = 1 TO 4 
    list[x].NextPointer <- x + 1   
 NEXT x
    
list[5].NextPointer <- 0

PROCEDURE AddItem():
    IF FreePointer == NullPointer THEN
        OUTPUT "Linked list is full"
    ELSE
        Data = INPUT("Enter Item")
        List[FreePointer].Node = Data

        // if it is the first data
        IF StartPointer == NullPointer THEN   
            StartPointer <- FreePointer
            Temp <- list[FreePointer].NextPointer
            list[FreePointer].NextPointer <- NullPointer
            FreePointer <- Temp
        ELSE

            // if it is the smallest data
            Temp <- list[FreePointer].NextPointer       
            IF Data < List[StartPointer].Node THEN
                List[FreePointer].NextPointer <- StartPointer
                StartPointer <- FreePointer
                FreePointer <- Temp
            ENDIF
        ELSE

            // if middle data    
            PreviousPointer <- NullPointer
            CurrentPointer <- StartPointer
            Found <- False
            REPEAT
                IF Item <= List[CurrentPointer].Node THEN
                    List[PreviousPointer].NextPointer <- FreePointer
                    List[FreePointer].NextPointer <- CurrentPointer
                    Found <- True
                    FreePointer <- Temp
                ELSE
                    PreviousPointer <- CurrentPointer
                    CurrentPointer <- List[CurrentPointer].NextPointer
                ENDIF
            UNTIL Found = True OR CurrentPointer = NullPointer

            // If the item is largest 
            IF Found = False THEN
                List[PreviousPointer].NextPointer <- FreePointer
                List[FreePointer].NextPointer <- NullPointer
                FreePointer <- Temp
            ENDIF



// DELETE NODE
PROCEDURE DeleteItem(item : STRING)
    Found <- False
    CurrentPointer <- StartPointer

    WHILE CurrentPointer <> NullPointer AND Found = False
    IF item = MyList[CurrentPointer].Node  THEN
        Found <- True
    ELSE
        PreviousPointer <- CurrentPointer
        CurrentPointer <- MyList[CurrentPointer].NextPointer
    ENDWHILE

    IF CurrentPointer <> NullPointer THEN

        IF CurrentPointer = StartPointer THEN
            StartPointer <- MyList[CurrentPointer].NextPointer
        ELSE
            MyList[PreviousPointer].NextPointer <- MyList[CurrentPointer].NextPointer    
        ENDIF

        MyList[CurrentPointer].NextPointer <- FreePointer
        FreePointer <- CurrentPointer
    ENDIF
END    

PROCEDURE SearchItem()

    // Is linkedList Empty

    IF StartPointer = NullPointer THEN
        OUTPUT "Linked List is Empty"
    ELSE
        OUTPUT "Enter a Search Value"
        INPUT SearchValue
        CurrentPointer <- StartPointer
        Found <- False
        REPEAT 
            IF SearchItem = MyList[CurrentPointer].Node THEN
                OUTPUT "Data found at position ", CurrentPointer
                Found <- True
            ELSE
                CurrentPointer <- MyList[CurrentPointer].NextPointer
        UNTIL Found = True OR CurrentPointer = NullPointer

        IF Found == False THEN
            OUTPUT "Data not found"
        ENDIF
    ENDIF





DECLARE Num1 , Num2 , Num3 , count : INTEGER
DECLARE AVG : REAL

count <- 1

FOR index <- 1 TO 600 STEP 3
    Num1 <- Array1[i]
    Num2 <- Array1[i+1]
    Num3 <- Array1[i+2]

    AVG <- (Num1 + Num2 + Num3) / 3

    Array2[count] <- AVG

    count <- count + 1
    
NEXT index
ENDFOR



INPUT weight 
INPUT max 
INPUT min

IF weight > min + 2 AND weight < max - 2  THEN
    OUTPUT "ACCEPTED"
ELSEIF (weight >= max - 2 AND weight <= max + 2) OR (weight >= min - 2 AND weight <= min + 2) THEN
    OUTPUT "RECHECK"
ELSE
    OUTPUT "REJECT"    
    