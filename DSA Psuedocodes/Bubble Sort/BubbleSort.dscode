DECLARE myList : ARRAY[0:8] OF INTEGER
DECLARE upperBound , LowerBound , index , temp , top :INTEGER
DECLARE swap : BOOLEAN


upperBound <- 8
LowerBound <- 0
top <- upperBound

// Double For loops least efficient
PROCEDURE BubbleSort(ARRAY A, INTEGER N)
    FOR i ← 0 TO N - 1 DO
        FOR j ← 0 TO N - i - 2 DO
            IF A[j] > A[j + 1] THEN
                TEMP ← A[j]
                A[j] ← A[j + 1]
                A[j + 1] ← TEMP
            ENDIF
        ENDFOR
    ENDFOR
ENDPROCEDURE

REPEAT
    FOR index = LowerBound TO top-1 STEP 
        swap <- False
        IF myList[index] > myList[index+1] THEN
            temp <- myList[index]
            myList[index] <- myList[index+1]
            myList[index+1] <- temp
            swap <- True
        ENDIF
    NEXT index
    top <- top - 1
UNTIL (NOT swap) OR (top = 0)


REPEAT
    swap <- true
    FOR index = LowerBound TO top-1 STEP 
        IF myList[index] > myList[index+1] THEN
            temp <- myList[index]
            myList[index] <- myList[index+1]
            myList[index+1] <- temp
            swap <- False
        ENDIF
    NEXT index
    top <- top - 1
UNTIL swap

PROCEDURE sort()
 REPEAT
     swap <- False
     FOR index = LowerBound TO top - 1 
         IF myList[index,1] > myList[index+1,1] THEN
             temp <- myList[index,1]
             myList[index , 1] <- myList[index+1 , 1]
             myList[index+1 , 1] <- temp
 
             temp <- myList[index,2]
             myList[index , 2] <- myList[index+1 , 2]
             myList[index+1 , 2] <- temp
             swap <- True
         ENDIF
     NEXT index
     top <- top - 1
 UNTIL NOT swap 


// Efficient one

Outer <- LENGHT(List) - 1
REPEAT
    Inner <- 0
    swap <- False
    REPEAT
        IF List[Inner] > List[Inner + 1] THEN
            temp <- List[Inner]
            List[Inner] <- List[Inner+1]
            List[Inner+1] <- temp
            swap <- True
        ENDIF
        Inner <- Inner + 1
    UNTIL Inner = Outer - 1
    Outer <- Outer - 1
UNTIL not swap


least Efficient
DECLARE myList ARRAY [1:10] OF INTEGER
maxLen = 10

FOR Outer <- 1 TO maxLen - 1  
    FOR Inner <- 1 TO maxLen - 1
        IF List[Inner] > List[Inner + 1] THEN
            temp <- List[Inner]
            List[Inner] <- List[Inner + 1]
            List[Inner + 1] <- temp
        ENDIF
    NEXT
NEXT

MOST Efficient
DECLARE myList ARRAY [1:10] OF INTEGER

Outer <- 10

REPEAT
    swap <- False
    Inner <- 0

    REPEAT
        IF List[Inner] > List[Inner + 1] THEN
            temp <- List[Inner]
            List[Inner] <- List[Inner + 1]
            List[Inner + 1] <- temp
            swap <- True
        ENDIF

        Inner <- Inner + 1
    UNTIL Inner = Outer - 1

    Outer <- Outer - 1
UNTIL NOT swap OR Outer = 1
