FUNCTION Factorial (number)

    IF num < 0 THEN
        RETURN -1
    ENDIF


    IF number == 0 THEN
        RETURN 1
    ENDIF

    factorial <- 1

    FOR index = number TO 1 STEP -1
        factorial <- factorial * index
    NEXT index
    ENDFOR

    RETURN factorial

END




